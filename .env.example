# Copy this file to .env. Never commit the real .env file.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The approved LiteLLM Proxy route for your environment.
LITELLM_PROXY_HOST=https://api.dev.ix.konecta-digital.com/litellm-test
LITELLM_MASTER_KEY=
LITELLM_MODEL=openai/gemini-2.5-flash-nothink

# Optional provider key when using the standalone local demo proxy route (if applicable).
GROQ_API_KEY=

# Safe demo identifiers. Do not use a customer name, email address, phone number, or message text.
OTEL_SERVICE_NAME=crewai-langfuse-tracing-demo
DEMO_TENANT_ID=demo-workspace
DEMO_CONVERSATION_ID=demo-session-001
DEMO_AGENT_ID=crew_customer_support_01
DEMO_CHANNEL=chat

